{% comment %}
  Quick view modal shell. Rendered once in layout/theme.liquid so every card on
  the site shares it. The content is fetched into [data-quick-view-body] by
  assets/card-product-custom.js from sections/quick-view.liquid.
{% endcomment %}

<div class="quick-view-modal" data-quick-view-modal hidden>
  <div class="quick-view-modal__overlay" data-quick-view-close></div>

  <div
    class="quick-view__dialog"
    role="dialog"
    aria-modal="true"
    aria-label="{{ 'products.product.view_full_details' | t }}"
    tabindex="-1"
  >
    <button
      type="button"
      class="quick-view__close"
      data-quick-view-close
      aria-label="{{ 'accessibility.close' | t }}"
    >
      {% render 'icon-close' %}
    </button>

    <div class="quick-view-modal__body" data-quick-view-body></div>
  </div>
</div>
