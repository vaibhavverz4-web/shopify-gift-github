{% comment %}
  Renders a dual-handle price range slider.

  Wraps Shopify's two price inputs rather than replacing them: the number
  fields keep their name attributes, so the facet form still submits exactly
  as before. The sliders carry no name and are purely a control surface.

  Accepts:
  - filter: {Object} a price_range filter from results.filters
  - filter_type: {String} 'vertical' | 'horizontal' | 'drawer'
  - uses_comma_decimals: {Boolean} set by facets.liquid
  - id_prefix: {String} optional, e.g. 'Mobile-' to keep ids unique

  Usage:
  {% render 'price-range-slider', filter: filter, filter_type: filter_type, uses_comma_decimals: uses_comma_decimals %}
{% endcomment %}


{%- liquid
  assign prefix = id_prefix | default: ''

  if uses_comma_decimals
    assign range_max = filter.range_max | money_without_currency | replace: '.', '' | replace: ',', '.'
  else
    assign range_max = filter.range_max | money_without_currency | replace: ',', ''
  endif

  assign current_min = 0
  if filter.min_value.value
    if uses_comma_decimals
      assign current_min = filter.min_value.value | money_without_currency | replace: '.', '' | replace: ',', '.'
    else
      assign current_min = filter.min_value.value | money_without_currency | replace: ',', ''
    endif
  endif

  assign current_max = range_max
  if filter.max_value.value
    if uses_comma_decimals
      assign current_max = filter.max_value.value | money_without_currency | replace: '.', '' | replace: ',', '.'
    else
      assign current_max = filter.max_value.value | money_without_currency | replace: ',', ''
    endif
  endif
-%}

<price-range class="facets__price price-slider" data-price-slider data-range-max="{{ range_max }}">
  <div class="price-slider__control">
    <output class="price-slider__bubble" data-bubble="min">
      {{- cart.currency.symbol }}{{ current_min -}}
    </output>
    <output class="price-slider__bubble" data-bubble="max">
      {{- cart.currency.symbol }}{{ current_max -}}
    </output>

    <span class="price-slider__track" aria-hidden="true">
      <span class="price-slider__fill" data-fill></span>
    </span>

    <input
      type="range"
      class="price-slider__range price-slider__range--min"
      data-range="min"
      min="0"
      max="{{ range_max }}"
      step="1"
      value="{{ current_min }}"
      aria-label="{{ 'products.facets.from' | t }}"
    >
    <input
      type="range"
      class="price-slider__range price-slider__range--max"
      data-range="max"
      min="0"
      max="{{ range_max }}"
      step="1"
      value="{{ current_max }}"
      aria-label="{{ 'products.facets.to' | t }}"
    >
  </div>

  <div class="price-slider__fields">
    <span class="field-currency">{{ cart.currency.symbol }}</span>
    <div class="field">
      <input
        class="field__input"
        data-input="min"
        name="{{ filter.min_value.param_name }}"
        id="{{ prefix }}Filter-{{ filter.label | escape }}-GTE"
        {% if filter.min_value.value %}value="{{ current_min }}"{% endif %}
        type="number"
        placeholder="0"
        min="0"
        max="{{ range_max }}"
        inputmode="decimal"
      >
      <label class="field__label" for="{{ prefix }}Filter-{{ filter.label | escape }}-GTE">
        {{- 'products.facets.from' | t -}}
      </label>
    </div>

    {%- if filter_type != 'vertical' -%}
      <span class="field-currency">{{ cart.currency.symbol }}</span>
    {%- endif -%}

    <div class="field">
      <input
        class="field__input"
        data-input="max"
        name="{{ filter.max_value.param_name }}"
        id="{{ prefix }}Filter-{{ filter.label | escape }}-LTE"
        {% if filter.max_value.value %}value="{{ current_max }}"{% endif %}
        type="number"
        min="0"
        max="{{ range_max }}"
        placeholder="{{ range_max }}"
        inputmode="decimal"
      >
      <label class="field__label" for="{{ prefix }}Filter-{{ filter.label | escape }}-LTE">
        {{- 'products.facets.to' | t -}}
      </label>
    </div>
  </div>
</price-range>
